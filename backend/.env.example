# --- App ---
ENVIRONMENT=local
# Local dev: SQLite (no server needed). Relative paths resolve inside backend/, wherever you start uvicorn.
#   DATABASE_URL=sqlite:///./dev.db
# Production: Postgres. postgres:// and postgresql:// URLs from your host work as-is.
DATABASE_URL=postgresql+psycopg2://applier:applier@localhost:5432/applier
# Migrate on startup: default on for SQLite, off for Postgres (run `python -m alembic upgrade head` when deploying).
#   AUTO_MIGRATE=true
CORS_ORIGINS=chrome-extension://*
JWT_SECRET=change-me
JWT_EXPIRATION_HOURS=720

# --- Google sign-in (Web application OAuth client) ---
GOOGLE_CLIENT_ID=

# --- AI (swap provider/model with env only; any LiteLLM model string works) ---
# Examples: anthropic/claude-sonnet-5-5 | openai/gpt-4.1 | openrouter/deepseek/deepseek-chat | ollama_chat/llama3.1
LLM_MODEL=anthropic/claude-sonnet-5-5
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
# Z.AI GLM: LLM_MODEL=zai/glm-5.2, leave LLM_API_BASE empty. Stop GLM spending tokens on thinking:
#   glm-5.2 and older: LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   glm-5.3 (cannot disable): LLM_EXTRA_BODY={"reasoning_effort": "low"}
LLM_EXTRA_BODY=
# Job-page detection: use a smaller/cheaper model here (falls back to LLM_MODEL). Output is capped
# (DETECT_LLM_MAX_TOKENS, default 600) and the page text trimmed (DETECT_TEXT_CHARS, default 3000).
# With a reasoning model such as GLM, disable thinking or 600 tokens can run out before the answer.
DETECT_LLM_MODEL=
DETECT_LLM_API_KEY=
DETECT_LLM_API_BASE=
DETECT_LLM_EXTRA_BODY=

# --- Email (Resend) ---
# Without RESEND_API_KEY, emails are logged and skipped. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Applier <noreply@yourdomain.com>
EMAIL_REPLY_TO=

# --- Product update emails ---
UPDATE_EMAIL_SEND_HOUR=9
UPDATE_EMAIL_SCHEDULER=true
UPDATE_EMAIL_FROM=
PUBLIC_API_URL=https://api.yourdomain.com

# --- Stripe (Buy credits) ---
# Test keys from dashboard.stripe.com/test/apikeys. Webhook: `stripe listen --forward-to localhost:8000/api/billing/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Usage ---
FREE_APPLICATIONS=10
PRICE_PER_APPLICATION_USD=0.10
MINIMUM_CHARGE_USD=3.00

