# Local development settings. Copy to backend/.env. Everything NOT listed here has a fixed default in app/config.py.
# For production use deploy/backend.env.production.example instead.

# ============================================================== REQUIRED
# Local: SQLite needs no server. Relative paths resolve inside backend/, wherever you start uvicorn.
DATABASE_URL=sqlite:///./dev.db
# Production uses Postgres (postgres:// and postgresql:// URLs from your host work as they are):
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any value works locally. On Postgres the app refuses to start with the placeholder.
JWT_SECRET=change-me

# Google "Web application" OAuth client (see docs/DEVELOPMENT.md). Same value in extension/.env.
GOOGLE_CLIENT_ID=
LLM_API_KEY=
RESEND_API_KEY=            # empty = emails are logged and skipped
STRIPE_SECRET_KEY=         # empty = Buy credits shows "not available yet". Use test keys (sk_test_...) locally.
STRIPE_WEBHOOK_SECRET=     # from `stripe listen --forward-to localhost:8000/api/billing/webhook`
PUBLIC_API_URL=http://localhost:8000
SITE_URL=                  # empty = the API serves the Stripe return page; http://localhost:3000 once the website runs

# ============================================================== ADJUSTABLE
FREE_APPLICATIONS=10
PRICE_PER_APPLICATION_USD=0.10
MINIMUM_CHARGE_USD=3.00

# AI. Any LiteLLM model string, for example:
#   anthropic/claude-sonnet-5-5 | openai/gpt-4.1 | openrouter/deepseek/deepseek-chat | ollama_chat/llama3.1
# Z.AI GLM: LLM_MODEL=zai/glm-5.3, leave LLM_API_BASE empty, and stop GLM spending tokens on thinking:
#   glm-5.2 and older: LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   glm-5.3 (cannot disable): LLM_EXTRA_BODY={"reasoning_effort": "low"}
LLM_MODEL=anthropic/claude-sonnet-5-5
LLM_API_BASE=
LLM_EXTRA_BODY=
# Job-page detection: a smaller model is fine (empty = use LLM_MODEL and LLM_API_KEY).
DETECT_LLM_MODEL=
DETECT_LLM_API_KEY=
DETECT_LLM_API_BASE=
DETECT_LLM_EXTRA_BODY=

# Email. EMAIL_FROM must be on a domain verified in Resend.
EMAIL_FROM=Applier <noreply@firebird-technologies.com>
EMAIL_REPLY_TO=
UPDATE_EMAIL_FROM=
