# Production settings. On the droplet, copy this to backend/.env and fill in the values:
#   cp deploy/backend.env.production.example backend/.env
# Never commit backend/.env. Everything NOT listed here has a fixed default in backend/app/config.py.
# Lines marked (same as local) can be copied from your local backend/.env.

# ============================================================== REQUIRED
# Hosted Postgres (for example Neon). Keep ?sslmode=require.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A long random secret. The app refuses to start without one. Generate with:  openssl rand -hex 32
JWT_SECRET=

GOOGLE_CLIENT_ID=                          # (same as local)
LLM_API_KEY=                               # (same as local)
RESEND_API_KEY=                            # (same as local)

# Stripe. Leave empty until payments are connected; buying credits then shows "not available yet".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The public address of this API (unsubscribe links use it).
PUBLIC_API_URL=https://api.applier.site

# The website. After paying, Stripe sends customers to <SITE_URL>/billing/success.
# Leave EMPTY until the website is live; then the API serves a plain return page itself.
SITE_URL=

# ============================================================== ADJUSTABLE (change, then restart the API)
# Credits and pricing
FREE_APPLICATIONS=10
PRICE_PER_APPLICATION_USD=0.10
MINIMUM_CHARGE_USD=3.00

# AI models (any LiteLLM model string). Same as local.
LLM_MODEL=
LLM_API_BASE=
LLM_EXTRA_BODY=
DETECT_LLM_MODEL=
DETECT_LLM_API_KEY=
DETECT_LLM_API_BASE=
DETECT_LLM_EXTRA_BODY=

# Email. EMAIL_FROM must be on a domain verified in Resend.
EMAIL_FROM=Applier <noreply@firebird-technologies.com>
EMAIL_REPLY_TO=
UPDATE_EMAIL_FROM=
