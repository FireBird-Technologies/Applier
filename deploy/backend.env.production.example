# Production settings. On the droplet, copy this to backend/.env and fill in every value:
#   cp deploy/backend.env.production.example backend/.env
# Never commit backend/.env. Values you can copy from your local backend/.env are marked (same as local).

ENVIRONMENT=production

# The public address of this API. Stripe sends customers back here, and unsubscribe links use it.
PUBLIC_API_URL=https://applier.site

# Hosted Postgres (for example Neon). Keep ?sslmode=require.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A long random secret. Generate one on the droplet with:  openssl rand -hex 32
JWT_SECRET=

GOOGLE_CLIENT_ID=                          # (same as local)

# One browser, one account. Leave on.
REQUIRE_DEVICE_ID=true
UPDATE_EMAIL_SCHEDULER=true

# --- AI (same as local) ---
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
LLM_EXTRA_BODY=
DETECT_LLM_MODEL=
DETECT_LLM_API_KEY=
DETECT_LLM_EXTRA_BODY=

# --- Email ---
RESEND_API_KEY=                            # (same as local)
EMAIL_FROM=Applier <noreply@firebird-technologies.com>
EMAIL_REPLY_TO=

# --- Stripe: use LIVE keys here when you are ready to take real payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_PROMO_CODES=true

# --- Credits and pricing ---
FREE_APPLICATIONS=10
PRICE_PER_APPLICATION_USD=0.10
MINIMUM_CHARGE_USD=3.00
SUGGESTED_CREDITS=50,100,250,500
MAX_CREDITS_PER_PURCHASE=2000
