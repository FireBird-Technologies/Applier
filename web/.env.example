# Public site URL (used for the sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Backend API origin. Prices (free credits, price per application, minimum, pack sizes) are read from
# /api/pricing so the site always matches checkout. Unset = built-in fallback numbers.
API_URL=http://localhost:8000   # production: https://api.applier.site
# Chrome Web Store listing for "Add to Chrome". Defaults to the built-in Applier listing; set to override.
# NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/pdclipieihbelafeihehmnpdiodfomae
# Shown in the footer and legal pages. Hidden when empty.
NEXT_PUBLIC_SUPPORT_EMAIL=
